# Use an AI Studio project with billing DISABLED. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_LLM_CALLS=4
MAX_OUTPUT_TOKENS=6000
MAX_INPUT_CHARS=60000
MAX_ARTICLES_PER_DAY=1
SOURCE_LOOKBACK_DAYS=14
MIN_REVIEW_SCORE=85
MIN_CATEGORY_SCORE=80
DUPLICATE_THRESHOLD=0.65
# Acknowledge your project has no billing account before making live calls.
FREE_TIER_ONLY=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# For https://owner.github.io/repository use /repository; for a user site leave empty.
NEXT_PUBLIC_BASE_PATH=
